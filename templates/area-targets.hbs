<div class="area-targets-body">
    <header class="area-rule">
        <img src="{{img}}" alt="" />
        <div>
            <h2>{{name}}</h2>
            <p class="hint">{{rule}}</p>
        </div>
    </header>

    {{#if caught.length}}
    <section class="area-caught">
        <h3>{{localize "ISAACS_AUTOMATION.Review.Caught"}} <span class="count">{{caught.length}}</span></h3>
        <ul>
            {{#each caught}}
            <li data-token-id="{{this.id}}">
                <label>
                    <input type="checkbox" name="target" value="{{this.id}}" {{#if this.checked}}checked{{/if}} />
                    <img src="{{this.img}}" alt="" />
                    <span class="who">{{this.name}}</span>
                    {{#if this.note}}<span class="note">{{this.note}}</span>{{/if}}
                </label>
            </li>
            {{/each}}
        </ul>
    </section>
    {{else}}
    <p class="empty">{{localize "ISAACS_AUTOMATION.Review.Empty"}}</p>
    {{/if}}

    {{#if rejected.length}}
    <section class="area-rejected">
        <h3>{{localize "ISAACS_AUTOMATION.Review.Rejected"}}</h3>
        <ul>
            {{#each rejected}}
            <li data-token-id="{{this.id}}">
                <img src="{{this.img}}" alt="" />
                <span class="who">{{this.name}}</span>
                <span class="reason">{{this.reason}}</span>
            </li>
            {{/each}}
        </ul>
    </section>
    {{/if}}

    {{#if canReaim}}
    <footer class="area-controls hint">
        {{localize "ISAACS_AUTOMATION.Review.ReaimHint"}}
    </footer>
    {{/if}}
</div>
